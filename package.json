{
  "name": "family-board-games",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "web": "node server.mjs",
    "build:mac": "electron-builder --mac",
    "dist": "electron-builder"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.local.familyboardgames",
    "productName": "同樂棋室",
    "files": [
      "electron/**/*",
      "src/**/*",
      "vendor/**/*",
      "index.html",
      "server.mjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {}
    }
  }
}
